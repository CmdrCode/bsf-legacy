global.a2m1_mrow[25] = "...........................##...............#...............................................########";
global.a2m1_mrow[26] = "...........................#.................#..............................................########";
global.a2m1_mrow[27] = "...........................#...............................................................#########";
global.a2m1_mrow[28] = "..........................#................#.#.............................................#########";
global.a2m1_mrow[29] = ".........................###.................#............................................##########";
global.a2m1_mrow[30] = ".#.......................####............................................................###########";
global.a2m1_mrow[31] = ".##......................#####..........................................................############";
global.a2m1_mrow[32] = ".##......................#...##............#...........................................#############";
global.a2m1_mrow[33] = "..#......................#####@@@.....................................................#############.";
global.a2m1_mrow[34] = "..#@@@.....................##.@@@..............##....................................##############.";
global.a2m1_mrow[35] = "..#@@@........................@@@..............@@@............................#####..##############.";
global.a2m1_mrow[36] = "..@@@@.........................##.............#@@@...........................#######.#############..";
global.a2m1_mrow[37] = "..@@@@#........##...#...........#.......#######@@@..........................#####################...";
global.a2m1_mrow[38] = "..@@@@.........####..............#..#####.................#####..#####......###################.....";
global.a2m1_mrow[39] = "..................................###....................##############.....##################......";

var stx_r, stx_c, stx_ch, stx_v, stx_c0;
for (stx_r = 0; stx_r < global.a2m1_rows; stx_r += 1) {
    for (stx_c = 0; stx_c < global.a2m1_cols; stx_c += 1) {
        stx_ch = string_char_at(global.a2m1_mrow[stx_r], stx_c + 1);
        stx_v = 0;
        if (stx_ch = "#") stx_v = 1;
        if (stx_ch = "@") stx_v = 2;
        global.a2m1_g[stx_r * global.a2m1_cols + stx_c] = stx_v;
    }
}
// Row runs. Nothing draws these — they are the sampling table a lightning
// strike picks its two endpoints from, which is why they are runs and not
// cells: one random pick lands anywhere in the storm, uniformly by area.
global.a2m1_nsp = 0;
for (stx_r = 0; stx_r < global.a2m1_rows; stx_r += 1) {
    stx_c0 = -1;
    for (stx_c = 0; stx_c <= global.a2m1_cols; stx_c += 1) {
        stx_v = 0;
        if (stx_c < global.a2m1_cols) stx_v = global.a2m1_g[stx_r * global.a2m1_cols + stx_c];
        if (stx_v > 0) {
            if (stx_c0 < 0) stx_c0 = stx_c;
        } else {
            if (stx_c0 >= 0) {
                global.a2m1_spx[global.a2m1_nsp] = stx_c0 * global.a2m1_cellsz;
                global.a2m1_spy[global.a2m1_nsp] = stx_r * global.a2m1_cellsz;
                global.a2m1_spw[global.a2m1_nsp] = (stx_c - stx_c0) * global.a2m1_cellsz;
                global.a2m1_nsp += 1;
                stx_c0 = -1;
            }
        }
    }
}

// ------------------------------------------------------------- define once
// GM7 has no room_delete, so a room_add per reload would leak one every time.
//
// One guard per index rather than one around the lot: a mod that grows a new
// object has to be able to claim it in a session that is already running, and a
// single `if (!variable_global_exists(ctr))` around everything would skip the
// new line forever on exactly the reload that needed it.
if (!variable_global_exists('a2m1_stormobj')) global.a2m1_stormobj = object_add();
if (!variable_global_exists('a2m1_puffobj')) global.a2m1_puffobj = object_add();
if (!variable_global_exists('a2m1_ctr')) {
global.a2m1_ctr = object_add();
global.act2_room1 = room_add();
room_set_code(global.act2_room1,
    'instance_create(0,0,ctr_GUI); instance_create(0,0,' + string(global.a2m1_ctr) + ');');
// The view is authored once and never re-asserted. mods/resolution.gml rewrites
// every room's view port at startup to the picked resolution -- that is how the
// drawing region gets built at anything other than 1024x768 -- so a reload that
// set this again would drop the mission room, and only the mission room, back to
// 4:3 inside a widescreen window.
room_set_view(global.act2_room1, 0, 1, 0, 0, 1024, 768, 0, 0, 1024, 768, 32, 32, -1, -1, -1);
room_set_view_enabled(global.act2_room1, 1);
}

